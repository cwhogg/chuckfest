# Database (Neon Postgres)
DATABASE_URL=

# Auth (Better Auth). Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Public base URL used in emailed/texted links (defaults to the Vercel production URL)
APP_URL=

# Email (Resend). The sender's domain must be verified in Resend to reach members.
RESEND_API_KEY=
RESEND_FROM_EMAIL="ChuckFest <trip@your-domain.com>"

# Sending controls
EMAILS_DISABLED=false       # kill switch: log everything, send nothing (email and SMS)
EMAIL_TEST_MODE=false       # send every email to EMAIL_TEST_RECIPIENT instead
EMAIL_TEST_RECIPIENT=

# Text messages (Twilio). Leave SMS_ENABLED=false until the number is registered.
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Vercel Cron (the 5-minute scheduled job sends this as a Bearer token)
CRON_SECRET=

# One-time site search script only (scripts/find-sites.ts)
ANTHROPIC_API_KEY=

# Old Supabase project, only for scripts/import-legacy.ts
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
